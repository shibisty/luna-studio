{
  "name": "luna-studio",
  "version": "0.1.0",
  "description": "The Luna site editor (GrapesJS with Luna's plugins and settings) as a local app: edit a site kept as a folder at localhost, export it as an archive, or sign in to a Luna dashboard and edit an application's site directly.",
  "type": "module",
  "bin": {
    "luna-studio": "bin/luna-studio.js"
  },
  "main": "./dist/server/index.js",
  "exports": {
    ".": "./dist/server/index.js",
    "./editor": "./dist/editor/luna-editor.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run bundle && npm run build:editor && npm run build:app && npm run build:server",
    "build:editor": "vite build --config vite.editor.config.ts",
    "build:app": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node bin/luna-studio.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:dashboard": "node scripts/sync-dashboard.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "bundle": "node scripts/bundle.mjs",
    "predev": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "vite": "5.4.11"
  },
  "devDependencies": {
    "@fontsource/roboto": "5.3.0",
    "@types/node": "^22.10.0",
    "fflate": "^0.8.3",
    "font-awesome": "4.7.0",
    "grapesjs": "0.23.9",
    "grapesjs-blocks-basic": "1.0.2",
    "grapesjs-blueprints": "0.2.0",
    "grapesjs-cloud-assets": "0.9.0",
    "grapesjs-component-countdown": "1.0.2",
    "grapesjs-context-menu": "1.1.0",
    "grapesjs-custom-code": "1.0.2",
    "grapesjs-fonts": "0.2.0",
    "grapesjs-navbar": "1.0.2",
    "grapesjs-parser-postcss": "1.0.3",
    "grapesjs-plugin-export": "1.0.12",
    "grapesjs-plugin-forms": "2.0.6",
    "grapesjs-preset-webpage": "1.0.3",
    "grapesjs-sidebar-tools": "2.2.0",
    "grapesjs-site-pages": "2.5.0",
    "grapesjs-storage": "0.2.0",
    "grapesjs-style-bg": "2.0.2",
    "grapesjs-style-filter": "1.0.2",
    "grapesjs-style-gradient": "3.0.3",
    "grapesjs-tabs": "1.0.6",
    "grapesjs-tooltip": "0.1.8",
    "grapesjs-tui-image-editor": "1.0.2",
    "grapesjs-typed": "2.0.1",
    "grapick": "0.1.13",
    "tui-code-snippet": "1.5.2",
    "tui-color-picker": "2.2.7",
    "tui-image-editor": "3.15.2",
    "typescript": "5.6.3",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "grapesjs",
    "luna",
    "site-editor",
    "cms",
    "page-builder",
    "vite"
  ],
  "author": "Alexander Shibisty",
  "license": "MIT"
}
